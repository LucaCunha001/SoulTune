{
  "name": "soultune-electron",
  "version": "1.0.1",
  "description": "SoulTune Electron App",
  "main": "main.js",
  "author": {
    "name": "Luceno",
    "email": "lcunhalula@gmail.com"
  },
  "scripts": {
    "start": "electron . --trace-warnings",
    "build": "electron-builder",
    "release": "cross-env GH_TOKEN=%GH_TOKEN% electron-builder --publish always"
  },
  "build": {
    "appId": "com.viora.soultune",
    "productName": "Soultune",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    },
    "files": [
      "**/*"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "LucaCunha001",
        "repo": "SoulTune"
      }
    ]
  },
  "devDependencies": {
    "electron": "^25.0.0",
    "electron-builder": "^26.8.1"
  },
  "dependencies": {
    "@xhayper/discord-rpc": "^1.3.1",
    "cross-env": "^10.1.0",
    "discord-api-types": "^0.38.42",
    "electron-log": "^5.4.3",
    "electron-updater": "^6.8.3",
    "express": "^4.18.0"
  },
  "icon": "icon.ico"
}

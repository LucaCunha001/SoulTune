{
  "name": "soultune-electron",
  "version": "1.0.5",
  "description": "Software para escutar todas as músicas de Undertale e Deltarune.",
  "main": "main.js",
  "repository": {
    "url": "https://github.com/LucaCunha001/SoulTune"
  },
  "author": {
    "name": "Luceno",
    "email": "lcunhalula@gmail.com"
  },
  "scripts": {
    "start": "electron . --trace-warnings",
    "build": "electron-builder",
    "release": "electron-builder --publish always"
  },
  "build": {
    "appId": "com.viora.soultune",
    "productName": "SoulTune",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "icon.png",
      "category": "Audio"
    },
    "files": [
      "main.js",
      "package.json",
      "package-lock.json",
      "rpc.js",
      "server.js",
      "updater.js",
      "preload.js",
      "albums_ready.json",
      "sources/**/*",
      "mus/**/*"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "LucaCunha001",
        "repo": "SoulTune",
        "releaseType": "draft"
      }
    ]
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "electron": "^25.0.0",
    "electron-builder": "^26.8.1",
    "eslint": "^10.1.0"
  },
  "dependencies": {
    "@xhayper/discord-rpc": "^1.3.1",
    "discord-api-types": "^0.38.42",
    "dotenv": "^17.3.1",
    "electron-log": "^5.4.3",
    "electron-updater": "^6.8.3",
    "express": "^4.18.0"
  },
  "icon": "icon.ico"
}

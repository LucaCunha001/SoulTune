{
  "name": "soultune",
  "version": "1.0.7",
  "description": "**SoulTune** é um aplicativo desenvolvido **JavaScript** usando **Electron** para que todos possam apreciar as incríveis trilhas sonoras de **Undertale** e **Deltarune**, compostas pelo lendário **Robert F. \"Toby\" Fox**, um verdadeiro gênio musical.",
  "homepage": "https://github.com/LucaCunha001/SoulTune#readme",
  "bugs": {
    "url": "https://github.com/LucaCunha001/SoulTune/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LucaCunha001/SoulTune.git"
  },
  "license": "ISC",
  "author": "Luceno",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "build": {
    "appId": "com.viora.soultune",
    "productName": "SoulTune",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "icon.png",
      "category": "Audio"
    },
    "files": [
      "main.js",
      "package.json",
      "package-lock.json",
      "rpc.js",
      "server.js",
      "updater.js",
      "preload.js",
      "albums_ready.json",
      "sources/**/*",
      "mus/**/*"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "LucaCunha001",
        "repo": "SoulTune",
        "releaseType": "draft"
      }
    ]
  },
  "devDependencies": {
    "electron": "^41.1.1",
    "electron-builder": "^26.8.1"
  },
  "dependencies": {
    "@xhayper/discord-rpc": "^1.3.3",
    "discord-api-types": "^0.38.44",
    "electron-log": "^5.4.3",
    "electron-updater": "^6.8.3",
    "express": "^5.2.1"
  }
}
